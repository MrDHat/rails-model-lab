#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
revision="$(cat benchmark-revision.txt)"
if [ ! -d vendor/ai-evals/.git ]; then
  git clone --filter=blob:none --no-checkout --depth 1 https://github.com/rails/ai-evals.git vendor/ai-evals
  git -C vendor/ai-evals sparse-checkout set tasks docker apps
fi
if ! git -C vendor/ai-evals cat-file -e "$revision^{commit}" 2>/dev/null; then
  git -C vendor/ai-evals fetch --depth 1 origin "$revision"
fi
git -C vendor/ai-evals checkout --detach "$revision"
bundle config set --local path vendor/bundle
bundle install
