#!/usr/bin/env bash
# Run an official task through lemans/miniswen with offline local MLX inference.
set -euo pipefail
# Keep the host awake only for this process tree; this does not override lid sleep.
if [ "$(uname -s)" = Darwin ] && [ "${MLX_AWAKE_WRAPPED:-0}" != 1 ]; then
  exec /usr/bin/caffeinate -i env MLX_AWAKE_WRAPPED=1 bash "$0" "$@"
fi
cd "$(dirname "$0")/.."
bench="$PWD/vendor/ai-evals"
task="${1:-at-announce-once}"
profile="${LOCAL_EVAL_PROFILE:-restricted}"
case "$profile" in
  restricted|official-limits) ;;
  *) echo "Unknown LOCAL_EVAL_PROFILE: $profile" >&2; exit 2 ;;
esac
benchmark_revision="$(cat benchmark-revision.txt)"
model=mlx-community/Qwen3.5-4B-4bit
revision=0e7ffd5c629ef7719d4cbc04069232580bfa9d9c
runtime="$PWD/runs/mlx-runtime"
python="$runtime/venv/bin/python"
if [ ! -f "$bench/bench.yml" ] || [ ! -d "$bench/tasks/$task" ]; then
  echo "Usage: $0 [official-task-name]" >&2
  exit 2
fi
if ! [[ "$task" =~ ^[a-z0-9-]+$ ]] || [ "$#" -gt 1 ]; then
  echo "Expected one official task name" >&2
  exit 2
fi
if [ "$(git -C "$bench" rev-parse HEAD)" != "$benchmark_revision" ] ||
   [ -n "$(git -C "$bench" status --porcelain)" ]; then
  echo "Official benchmark must be clean at $benchmark_revision" >&2
  exit 2
fi
if [ ! -x "$python" ] || [ ! -f "$runtime/model-path.txt" ]; then
  echo "Install the pinned local MLX runtime and download the pinned snapshot first" >&2
  exit 2
fi
model_path="$(cat "$runtime/model-path.txt")"
if [ "$(basename "$model_path")" != "$revision" ] || [ ! -f "$model_path/model.safetensors" ]; then
  echo "Expected the pinned local model snapshot" >&2
  exit 2
fi
bench="$(cd "$bench" && pwd)"
run_root="$(mktemp -d "$PWD/runs/local-evaluation-XXXXXX")"
export LOCAL_RELAY_DIR="$run_root/relay"
export LOCAL_MODEL_REVISION="$revision"
export LOCAL_PREFILL_CHUNK_SIZE=1024
export LOCAL_INPUT_TOKEN_LIMIT=16384
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1
export HF_HOME="$runtime/hf"
mkdir -p "$run_root/bench" "$LOCAL_RELAY_DIR"
cp -R "$bench/apps" "$bench/docker" "$bench/tasks" "$run_root/bench/"
bundle exec ruby -ryaml -e '
  config = YAML.load_file(ARGV.fetch(1))
  limits = { "timeout" => "30m", "step_limit" => 32, "exec_timeout" => 60 }
  if ARGV.fetch(3) == "official-limits"
    limits = config.fetch("agent").slice("timeout", "step_limit", "exec_timeout")
    raise "Incomplete upstream limits" unless limits.size == 3
  end
  config["agent"] = {
    "name" => "miniswen", "model" => "ollama/" + ARGV.fetch(2),
    "max_output_tokens" => 2048
  }.merge(limits)
  File.write(ARGV.fetch(0), YAML.dump(config))
' "$run_root/bench/bench.yml" "$bench/bench.yml" "$model" "$profile"
python3 - "$run_root" "$bench" "$task" "$model_path" <<'PYTHON'
import hashlib,json,sys
from pathlib import Path
root,source,task,model_path=sys.argv[1:]
root=Path(root)
manifest={str(p.relative_to(root/'bench')):hashlib.sha256(p.read_bytes()).hexdigest()
          for p in sorted((root/'bench').rglob('*')) if p.is_file()}
(root/'evaluation-inputs.json').write_text(json.dumps({
    'source_bench':source,'task':task,'sha256':manifest},indent=2)+'\n')
# Record immutable downloaded bytes as well as the community repository revision.
manifest={}
for p in sorted(Path(model_path).iterdir()):
    if p.is_file():
        with p.open('rb') as stream:
            manifest[p.name]=hashlib.file_digest(stream,'sha256').hexdigest()
(root/'model-files.json').write_text(json.dumps(manifest,indent=2)+'\n')
PYTHON
git rev-parse HEAD > "$run_root/repository-revision.txt"
git diff > "$run_root/working-tree.patch"
printf '%s\n' "$benchmark_revision" > "$run_root/benchmark-revision.txt"
cp bin/run-local-evaluation experiments/local-file-provider.rb \
  experiments/mlx-file-worker.py Gemfile.lock "$runtime/requirements.lock" "$run_root/"
echo "Local MLX evidence: $run_root"
"$python" experiments/mlx-file-worker.py "$run_root" "$model_path" > "$run_root/worker.log" 2>&1 &
worker_pid=$!
cleanup() {
  touch "$run_root/stop-worker"
  kill "$worker_pid" 2>/dev/null || true
  wait "$worker_pid" 2>/dev/null || true
}
trap cleanup EXIT
bundle exec lemans run --require experiments/local-file-provider.rb \
  --bench "$run_root/bench" --backend docker --task "$task" \
  --attempts 1 --concurrency 1 --runs-dir "$run_root/trials"
