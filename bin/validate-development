#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
bench="${1:-evals/development}"
task="${2:-expense-claim-submission}"
for artifact in verification_test.rb solution.patch; do
  if [ ! -s "$bench/tasks/$task/$artifact" ]; then
    echo "Missing local evaluation file: $bench/tasks/$task/$artifact" >&2
    echo "Private grader/reference files must be present before no-model validation." >&2
    exit 2
  fi
done
mkdir -p runs
run_root="$(mktemp -d "$PWD/runs/development-validation-XXXXXX")"
for agent in oracle nop; do
  bundle exec lemans run --bench "$bench" --backend docker \
    --task "$task" --agent "$agent" --attempts 1 --concurrency 1 \
    --runs-dir "$run_root/$agent"
done
python3 - "$run_root" <<'PYTHON'
import json
from pathlib import Path
import sys
root = Path(sys.argv[1])
for agent, expected in [('oracle', 1.0), ('nop', 0.0)]:
    paths = list((root / agent).rglob('result.json'))
    assert len(paths) == 1, (agent, paths)
    result = json.loads(paths[0].read_text())
    assert result['outcome']['name'] == 'completed', result
    assert result['reward'] == expected, result
    assert result['usage']['input_tokens'] == 0, result
    print(f"{agent}: completed, score {result['reward']}")
print(f'Evidence: {root}')
PYTHON
