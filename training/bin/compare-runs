#!/usr/bin/env ruby
# frozen_string_literal: true

# Is model B really better than model A on the same tasks, or just luckier?
#
# Score: mean credit per task, then the mean over tasks, so every task counts
# the same however many attempts it got. Only tasks both runs scored are
# compared. The 95% range comes from a paired bootstrap: draw the tasks again
# with replacement, and within each drawn task draw each model's attempts again,
# many times over; the middle 95% of the resulting differences is the range. It
# covers both sources of luck: which tasks we happened to write, and how each
# attempt happened to go.
#
# Verdict, fixed in advance (see training/TEST-RULES.md): "better" only when the
# whole range is above 0, "worse" when it is all below 0, otherwise "no clear
# difference".
#
# With --groups (default training/test-targets.json, when present), tasks in its
# "transfer" map and the other targeted tasks ("novel") get their own lines.
#
#   ruby training/bin/compare-runs [--resamples N] [--seed N] [--groups FILE] RUNS_A RUNS_B
require "json"
require "optparse"

options = { resamples: 10_000, seed: 20_261_125, groups: File.expand_path("../test-targets.json", __dir__) }
OptionParser.new do |o|
  o.banner = "usage: compare-runs [--resamples N] [--seed N] [--groups FILE] RUNS_A RUNS_B"
  o.on("--resamples N", Integer) { options[:resamples] = _1 }
  o.on("--seed N", Integer) { options[:seed] = _1 }
  o.on("--groups FILE") { options[:groups] = _1 }
end.parse!
abort "usage: compare-runs [--resamples N] [--seed N] [--groups FILE] RUNS_A RUNS_B" unless ARGV.size == 2

def credits_by_task(dir)
  Dir.glob(File.join(dir, "**", "result.json")).each_with_object(Hash.new { |h, k| h[k] = [] }) do |path, by_task|
    result = JSON.parse(File.read(path, encoding: "UTF-8"))
    next unless result.dig("outcome", "scored")

    by_task[result["task"]] << result["credit"].to_f
  end
end

def mean(values) = values.sum / values.size

def resample(values, rng) = Array.new(values.size) { values[rng.rand(values.size)] }

def percentile(sorted, fraction)
  position = fraction * (sorted.size - 1)
  low = sorted[position.floor]
  high = sorted[position.ceil]
  low + (high - low) * (position - position.floor)
end

a_dir, b_dir = ARGV
a = credits_by_task(a_dir)
b = credits_by_task(b_dir)
shared = (a.keys & b.keys).sort
abort "no task was scored in both runs" if shared.empty?

only = (a.keys | b.keys) - shared
warn "left out, scored in only one run: #{only.sort.join(', ')}" if only.any?

groups = { "all" => shared }
if options[:groups] && File.exist?(options[:groups])
  config = JSON.parse(File.read(options[:groups]))
  targeted = config.fetch("targets", {}).keys
  transfer = config.fetch("transfer", {}).keys
  novel = shared & (targeted - transfer)
  transfer_shared = shared & transfer
  groups["novel"] = novel if novel.any?
  groups["transfer"] = transfer_shared if transfer_shared.any?
end

name = ->(dir) { File.basename(File.expand_path(dir)) }
puts "A = #{name[a_dir]}"
puts "B = #{name[b_dir]}"
puts "paired bootstrap, #{options[:resamples]} resamples, seed #{options[:seed]}"
puts
header = %w[tasks group attempts\ A attempts\ B score\ A score\ B B-A 95%\ range verdict]
rows = groups.map do |group, tasks|
  rng = Random.new(options[:seed])
  score_a = mean(tasks.map { mean(a[_1]) })
  score_b = mean(tasks.map { mean(b[_1]) })
  diffs = Array.new(options[:resamples]) do
    drawn = resample(tasks, rng)
    mean(drawn.map { mean(resample(b[_1], rng)) - mean(resample(a[_1], rng)) })
  end.sort
  low = percentile(diffs, 0.025)
  high = percentile(diffs, 0.975)
  verdict = if low.positive? then "better"
            elsif high.negative? then "worse"
            else "no clear difference"
            end
  [tasks.size, group, tasks.sum { a[_1].size }, tasks.sum { b[_1].size },
   format("%.3f", score_a), format("%.3f", score_b), format("%+.3f", score_b - score_a),
   format("%+.3f to %+.3f", low, high), verdict]
end
widths = header.each_index.map { |i| ([header] + rows).map { _1[i].to_s.size }.max }
[header, *rows].each { |row| puts row.each_with_index.map { |cell, i| cell.to_s.ljust(widths[i]) }.join("  ").rstrip }
