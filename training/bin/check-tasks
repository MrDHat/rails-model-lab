#!/usr/bin/env ruby
# Scores every answer file in every task, the way the benchmark scores a fix:
# behaviour tests must pass, and the API check decides full (1.0) or partial
# (0.1) credit. A task without an API check gives full credit for passing.
# Exits non-zero if any answer scores differently from what its role expects.
#
# Answers in a task's attacks/ folder were written by reviewers to break the
# tests; each states its expected credit on its first line.
#
#   training/check-tasks.sh            # runs this inside the pinned image
#   training/check-tasks.sh reservation-dates
require "etc"
require "open3"

EXPECTED = { "reference.rb" => 1.0, "handrolled.rb" => 0.1, "starter.rb" => 0.0, "broken.rb" => 0.0 }
tasks_dir = File.expand_path("../tasks", __dir__)
tasks = ARGV.empty? ? Dir.children(tasks_dir).sort : ARGV

def passes?(dir, test, answer)
  _, status = Open3.capture2e({ "CANDIDATE_IMPLEMENTATION" => answer }, "ruby", test, "--seed", "1", chdir: dir)
  status.success?
end

def answers(dir)
  roles = EXPECTED.select { |answer, _| File.exist?(File.join(dir, answer)) }.to_a
  attacks = Dir[File.join(dir, "attacks", "*.rb")].sort.map do |path|
    credit = File.open(path, &:readline)[/\A# Expected credit (\d\.\d):/, 1] or abort("#{path}: no expected credit")
    ["attacks/#{File.basename(path)}", credit.to_f]
  end
  roles + attacks
end

jobs = tasks.flat_map { |task| answers(File.join(tasks_dir, task)).map { |answer, expected| [task, answer, expected] } }
queue = Queue.new
jobs.each_with_index { queue << _2 }
rows = Array.new(jobs.size)
Array.new(Etc.nprocessors) do
  Thread.new do
    while (i = queue.pop(true) rescue nil)
      task, answer, expected = jobs[i]
      dir = File.join(tasks_dir, task)
      tests = passes?(dir, "behaviour_test.rb", answer)
      api = File.exist?(File.join(dir, "api_check_test.rb")) ? passes?(dir, "api_check_test.rb", answer) : nil
      rows[i] = [task, answer, tests, api, !tests ? 0.0 : (api == false ? 0.1 : 1.0), expected]
    end
  end
end.each(&:join)

failures = 0
puts format("%-30s %-24s %-9s %-9s %s", "task", "answer", "tests", "api", "credit")
rows.each do |task, answer, tests, api, credit, expected|
  ok = credit == expected
  failures += 1 unless ok
  puts format("%-30s %-24s %-9s %-9s %.1f%s", task, answer, tests ? "pass" : "fail",
              api.nil? ? "-" : (api ? "pass" : "fail"), credit, ok ? "" : "  <- expected #{expected}")
end
exit(failures.zero? ? 0 : 1)
