<h1>Orders for <%= @day.to_fs(:long) %></h1>
<table>
  <thead><tr><th>#</th><th>Customer</th><th>Placed</th><th>Waiting</th><th>Total</th></tr></thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr id="<%= dom_id(order) %>">
        <td><%= link_to order.id, admin_order_path(order) %></td>
        <td><%= order.customer.name %></td>
        <td><%= order.placed_at.strftime("%H:%M") %></td>
        <td><%= time_ago_in_words(order.placed_at) %> ago</td>
        <td><%= number_to_currency(order.total_cents / 100.0, unit: "€") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
