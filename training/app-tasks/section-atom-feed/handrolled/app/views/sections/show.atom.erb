<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id><%= section_url(@section) %></id>
  <link rel="alternate" type="text/html" href="<%= section_url(@section) %>"/>
  <link rel="self" type="application/atom+xml" href="<%= section_url(@section, format: :atom) %>"/>
  <title><%= @section.name %> | The Harbour Gazette</title>
  <updated><%= (@articles.map(&:updated_at).max || @section.updated_at).xmlschema %></updated>
  <% @articles.each do |article| %>
  <entry>
    <id><%= article_url(article) %></id>
    <published><%= article.published_at.xmlschema %></published>
    <updated><%= article.updated_at.xmlschema %></updated>
    <link rel="alternate" type="text/html" href="<%= article_url(article) %>"/>
    <title><%= article.headline %></title>
    <summary><%= article.dek %></summary>
    <% article.authors.each do |author| %>
    <author><name><%= author.name %></name></author>
    <% end %>
  </entry>
  <% end %>
</feed>
