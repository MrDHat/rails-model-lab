<h1>Categories</h1>
<ul>
  <% @categories.each do |category| %>
    <li id="<%= dom_id(category) %>"><%= category.name %> <%= button_to "Delete", category_path(category), method: :delete %></li>
  <% end %>
</ul>
<%= form_with model: Category.new do |f| %>
  <%= f.text_field :name %> <%= f.submit "Add category" %>
<% end %>
