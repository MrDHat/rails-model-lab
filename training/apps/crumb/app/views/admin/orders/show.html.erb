<h1>Order #<%= @order.id %></h1>
<p><%= @order.customer.name %> (<%= @order.customer.email %>) · placed <%= @order.placed_at.strftime("%d %b %H:%M") %></p>
<ul>
  <% @order.order_items.each do |item| %>
    <li><%= item.quantity %> x <%= item.product.name %></li>
  <% end %>
</ul>
<p>Total <%= number_to_currency(@order.total_cents / 100.0, unit: "€") %></p>
