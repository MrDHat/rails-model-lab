<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Crumb" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag :app %>
  </head>
  <body>
    <nav><%= link_to "Products", products_path %> · <%= link_to "Today's orders", admin_orders_path %></nav>
    <% flash.each do |type, message| %>
      <p class="flash <%= type %>"><%= message %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
