<h1>Search</h1>
<% if @query.present? %>
  <p><%= pluralize(@articles.size, "story") %> matching “<%= @query %>”</p>
  <% @articles.each do |article| %>
    <p class="result"><%= link_to article.headline, article_path(article) %> <span class="section"><%= article.section.name %></span></p>
  <% end %>
<% end %>
