<h1>Stories</h1>
<%= form_with url: newsroom_articles_path, method: :get do |f| %>
  <%= f.select :status, Article.statuses.keys, include_blank: "Any status", selected: params[:status] %>
  <%= f.select :section_id, Section.order(:name).map { [_1.name, _1.id] }, include_blank: "Any section", selected: params[:section_id] %>
  <%= f.search_field :q, value: params[:q] %>
  <%= f.submit "Filter" %>
<% end %>
<p><%= link_to "New story", new_newsroom_article_path %></p>
<table>
  <% @articles.each do |article| %>
    <tr id="<%= dom_id(article) %>">
      <td><%= link_to article.headline, edit_newsroom_article_path(article) %></td>
      <td><%= article.section.name %></td>
      <td><%= article.authors.map(&:name).join(", ") %></td>
      <td><%= status_label(article) %></td>
      <td><%= article.views_count %></td>
    </tr>
  <% end %>
</table>
