<h1>Letters</h1>
<table>
  <% @letters.each do |letter| %>
    <tr id="<%= dom_id(letter) %>">
      <td><%= link_to letter.subject, newsroom_letter_path(letter) %></td>
      <td><%= letter.signature %></td>
      <td><%= letter.status %></td>
      <td><%= dateline(letter.created_at) %></td>
    </tr>
  <% end %>
</table>
