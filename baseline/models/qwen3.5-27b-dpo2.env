# Qwen3.5-27B with the second-round DPO LoRA merged into qwen3.5-27b-dpo (training/sft/merge.py),
# served from local weights under the same settings as the base 27B.
MODEL=rails-qwen3.5-27b-dpo2
WEIGHTS=/root/.cache/huggingface/merged/qwen3.5-27b-dpo2
MODEL_REVISION=local
MAX_SEQS=6
GPU_MEMORY_UTILIZATION=0.90
