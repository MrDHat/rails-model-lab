# Same sampling and serving flags as the 4B; only size and hardware differ.
# BF16 weights are 55.6 GB. KV cache is 64 KiB/token (16 full-attention
# layers), so an H200 leaves room for about 1.3M cached tokens across agents.
MODEL=Qwen/Qwen3.5-27B
MODEL_REVISION=fc05daec18b0a78c049392ed2e771dde82bdf654
MODAL_APP=rails-qwen-27b
MODAL_GPU=H200
MODAL_MEMORY_MB=65536
MAX_SEQS=6
GPU_MEMORY_UTILIZATION=0.90
